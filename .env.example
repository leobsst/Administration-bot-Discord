# Token du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Optionnel : ID d'un serveur pour déployer les commandes uniquement dessus (instantané, utile en dev).
# Laisser vide pour un déploiement global.
GUILD_ID=

# Optionnel : messages de bienvenue / départ et rôle automatique.
# Nécessite d'activer "Server Members Intent" dans le Developer Portal.
WELCOME_CHANNEL_ID=
WELCOME_ROLE_ID=
